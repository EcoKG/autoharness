{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" brief --repo \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" hook-prebash --repo \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" hook-postbash --repo \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" hook-stop --repo \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent_harness.sh:*)",
      "Bash(python scripts/harness_engine.py:*)",
      "Bash(\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" run:*)",
      "Bash(\"C:\\Users\\ruinp\\.claude\\autoharness\\bin\\autoharness.exe\" next:*)"
    ]
  }
}
